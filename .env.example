# Copy to .env and fill in from Supabase → Project Settings → API.
# Both are required: without them the app throws at startup, and — because the
# throw is at module top level — a production build constant-folds it and
# tree-shakes the entire application out of the bundle. A build with no env
# therefore "succeeds" while producing an artifact that renders nothing.
# See scripts/verify-build.mjs, which turns that into a hard failure.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
